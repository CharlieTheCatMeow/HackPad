{
    "manufacturer": "Xuan Zhu",
    "keyboard_name": "hackpad_v3",
    "maintainer": "CharlieTheCatMeow",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "diode_direction": "ROW2COL",
    "features": {
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "rgblight": true, 
		"oled": true,
		"encoder_map": true
    },
    "matrix_pins": {
        "cols": ["GP1", "GP28", "GP29"],
        "rows": ["GP3", "GP4", "GP2"]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP27", "pin_b": "GP26"}
        ]
    },
    "rgblight": {
        "pin": "GP0",
        "led_count": 6,
        "max_brightness": 150
    },
    "ws2812": {
        "driver": "vendor",
        "pin": "GP0"
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}